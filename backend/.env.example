# Required
MONGODB_URI=mongodb+srv://<db-user>:<encoded-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
STORE_OWNER_ID=<verified-vendor-object-id-from-this-database>
JWT_SECRET=<long-random-secret>
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
EMAIL_USER=<smtp-gmail-address>
EMAIL_PASS=<gmail-app-password>
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Set both to use Shiprocket. Credentials are managed only in the backend environment.
SHIPROCKET_EMAIL=<shiprocket-api-user-email>
SHIPROCKET_PASSWORD=<shiprocket-api-user-password>

# Optional: prefer a specific numeric courier ID; otherwise the lowest valid rate is selected.
# SHIPROCKET_COURIER_ID=<numeric-courier-id>

# Optional: needed only for Google sign-in.
# GOOGLE_CLIENT_ID=<google-oauth-client-id>

# Render supplies PORT; local development defaults to 3000.
# PORT=3000
